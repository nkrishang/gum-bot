{
  "name": "gum-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Perpetual live-volume tester for Gum: creates deposits, pays them from mover keys, tracks settlement, keeps movers fuelled.",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "local": "node --disable-warning=ExperimentalWarning --import tsx dev/local.ts",
    "bootstrap": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "test:e2e": "node --disable-warning=ExperimentalWarning --import tsx --test test/local.e2e.ts",
    "setup-movers": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx scripts/setup-movers.ts",
    "recover-stranded": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx scripts/recover-stranded.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pino-pretty": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
