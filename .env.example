# gum-bot configuration.
#   Local:   cp .env.example .env, fill in the REQUIRED block, `pnpm dev`.
#   Railway: set the REQUIRED variables on the service, plus any OPTIONAL one you want to change.
# The bot refuses to start until every required value is valid, and lists everything missing at once.


# =============================================================================================
# REQUIRED: the bot will not start without these.
# =============================================================================================

# A Gum API key dedicated to this bot (the bot is built to use its whole 50 req/s budget).
GUM_API_KEY=

# Holds MON / ETH on every enabled chain and pays the movers' gas top-ups.
FUNDER_PRIVATE_KEY=

# The mover wallets, each holding 1 USDC. Set exactly ONE of these two:
#   MOVER_PRIVATE_KEYS  comma-separated private keys (the count is however many you list), or
#   MOVER_MNEMONIC      one mnemonic; movers are m/44'/60'/0'/0/0 .. MOVER_COUNT-1.
# `pnpm setup-movers` creates and funds them, and writes the MOVER_PRIVATE_KEYS line for you.
MOVER_PRIVATE_KEYS=
MOVER_MNEMONIC=

# One RPC endpoint per chain in CHAINS (all three by default).
RPC_URL_MONAD=
RPC_URL_BASE=
RPC_URL_ARBITRUM=


# =============================================================================================
# OPTIONAL: every value below is already the built-in default, so you can change what you need
# and delete the rest. A deleted line behaves exactly like the value shown here.
# =============================================================================================

# ---- Movers & chains -------------------------------------------------------------------------
# How many movers to derive from MOVER_MNEMONIC (ignored with MOVER_PRIVATE_KEYS).
MOVER_COUNT=50
# Chains to test. Drop one to stop testing it (and you can then drop its RPC_URL).
CHAINS=monad,base,arbitrum
# Mover i pays on MOVER_CHAIN_ROTATION[i % length]; repeat a chain to weight it, e.g.
# base,base,arbitrum,monad. A mover whose USDC is on a different enabled chain pays there instead.
MOVER_CHAIN_ROTATION=monad,base,arbitrum

# ---- RPC limits --------------------------------------------------------------------------------
# Max JSON-RPC calls per second the bot makes to each chain's RPC; every call inside a batch counts.
# Match your provider's plan with some headroom, e.g. QuickNode Build allows 50/s, so use 40.
RPC_RPS_MONAD=25
RPC_RPS_BASE=25
RPC_RPS_ARBITRUM=25

# ---- Gas top-ups (amounts in the chain's native token: MON / ETH) ----------------------------
# When a mover's balance drops below GAS_MIN, the funder sends it GAS_TOPUP.
# FUNDER_MIN only raises a dashboard alert when the funder itself runs low.
# Monad charges for the gas limit rather than gas used, hence the larger numbers; tune to current fees.
GAS_MIN_MONAD=0.5
GAS_TOPUP_MONAD=2
FUNDER_MIN_MONAD=20
GAS_MIN_BASE=0.00002
GAS_TOPUP_BASE=0.0001
FUNDER_MIN_BASE=0.002
GAS_MIN_ARBITRUM=0.00002
GAS_TOPUP_ARBITRUM=0.0001
FUNDER_MIN_ARBITRUM=0.002

# ---- Deposits & the cycle ----------------------------------------------------------------------
# Base units: 1000000 = 1 USDC.
DEPOSIT_AMOUNT=1000000
# Gum requires expires_at at least 300s out; minimum 360.
DEPOSIT_EXPIRY_SECS=1800
# Hard cap: at most this many deposits created in any rolling 60 seconds (bursts allowed). 0 = no cap.
MAX_DEPOSITS_PER_MINUTE=50
# A new cycle never starts sooner than this after the previous one started.
CYCLE_MIN_INTERVAL_MS=10000
# Deposits still unsettled after this carry over, and the next cycle starts without them.
CYCLE_SETTLE_TIMEOUT_MS=600000
STATUS_POLL_INTERVAL_MS=3000
BALANCE_REFRESH_MS=15000
# One extra GET per finished deposit, for the per-stage latency breakdown on the dashboard.
FETCH_DEPOSIT_EVENTS=true
# Applies to the very first boot only; after that the dashboard's pause/resume state persists.
START_PAUSED=false

# ---- Gum API -----------------------------------------------------------------------------------
GUM_API_URL=https://api.gum.money
# Client-side cap, kept under Gum's per-key limit (50/s, burst 100). Max 50.
GUM_RATE_LIMIT_RPS=40
GUM_RATE_LIMIT_BURST=60

# ---- Webhooks (off by default; status polling works without them) -----------------------------
# Set both to turn them on: every deposit then carries webhook_url=$PUBLIC_URL/webhooks/gum, and
# deliveries are verified with the account's webhook secret (Gum web UI). Gum needs a public https URL.
PUBLIC_URL=
GUM_WEBHOOK_SECRET=

# ---- Dashboard & service -----------------------------------------------------------------------
PORT=8080
# Basic auth for the dashboard and /api. Empty = no auth: set a password on anything public, since
# the dashboard can pause the bot and trigger top-ups.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# If set, GET /metrics requires `Authorization: Bearer <token>`. Empty = open.
METRICS_TOKEN=

# ---- Alerts (off when empty) ----------------------------------------------------------------
# Slack or Discord incoming-webhook URL. Posts when paid deposits don't settle, deposits fail or expire
# after payment, the bot goes idle, RPC fails, movers run out of gas/USDC, the funder runs low, and on
# every (re)start. Each condition alerts once, reminds hourly, and posts when it clears.
ALERT_WEBHOOK_URL=
# A paid deposit still unsettled after this many seconds is an alert.
ALERT_STUCK_SECS=180
# No deposit created for this many seconds while the bot isn't paused is an alert.
ALERT_IDLE_SECS=600
# SQLite history. On Railway, mount a volume and set this to /data (the Docker image already does).
DATA_DIR=./data
RETAIN_DAYS=30
LOG_LEVEL=info
# json or pretty
LOG_FORMAT=json
